# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PORT: server port (default 3000)
# PORT=3100

# ── Movie data ───────────────────────────────────────────────────────────────
# TMDB_API_KEY: Required for real search (discover by mood/genre/language/platform), posters and
# streaming providers. Free: https://www.themoviedb.org/settings/api — either the v3 "API Key"
# or the v4 "API Read Access Token" works.
TMDB_API_KEY="MY_TMDB_API_KEY"

# Optional: TMDB host. api.themoviedb.org is blocked on some Indian ISPs (Jio), so api.tmdb.org is the default.
# TMDB_API_HOST="https://api.tmdb.org/3"

# ── Free AI (the default every visitor gets) ────────────────────────────────
# Visitors can also bring their own OpenAI / Claude / Gemini / NVIDIA / OpenAI-compatible key from
# the "AI engine" button in the app; those keys stay in their browser and are never stored here.
#
# LLM_PROVIDER: nvidia | openai | anthropic | gemini | openai_compatible
LLM_PROVIDER="nvidia"
# The key for that provider (use the matching variable, or LLM_API_KEY for any provider):
NVIDIA_API_KEY="MY_NVIDIA_API_KEY"
# OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""
# GEMINI_API_KEY=""
# LLM_API_KEY=""
#
# Optional overrides
# LLM_MODEL="nvidia/nemotron-3-super-120b-a12b"   # provider default if unset
# LLM_BASE_URL=""                                  # required for openai_compatible
# LLM_EMBED_MODEL="nvidia/nemotron-3-embed-1b"     # meaning-based matching; provider default if unset
# FREE_AI_REQUESTS_PER_HOUR=60                     # per-visitor limit on the free AI, then local ranking
# ALLOW_LOCAL_LLM_URLS=false                       # true only for local dev against e.g. Ollama on localhost
